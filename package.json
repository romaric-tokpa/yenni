{
  "name": "monbudget",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev --webpack",
    "dev:fresh": "rm -rf .next && npm run build && npm run dev",
    "build": "next build --webpack",
    "docker:build": "docker compose build",
    "docker:build:no-cache": "docker compose build --no-cache",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:rebuild": "docker compose down && docker compose build --no-cache && docker compose up -d",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.23",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.37.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-pwa": "^5.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
