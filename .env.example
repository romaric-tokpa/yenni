# ===========================================
# Yenni — Variables d'environnement
# ===========================================
# Copiez ce fichier en .env.local et remplissez les valeurs.

# --- Obligatoire en production ---
# Secret pour signer les JWT (sessions). Minimum 32 caractères.
# Générer : openssl rand -base64 32
JWT_SECRET=votre-secret-jwt-minimum-32-caracteres

# --- Base de données Turso (optionnel) ---
# Sans ces variables, l'app utilise SQLite locale (data/budget.db)
# TURSO_DATABASE_URL=libsql://votre-db-votre-org.turso.io
# TURSO_AUTH_TOKEN=votre-token-turso

# --- Cookies (optionnel) ---
# Mettre à "true" si l'app est servie en HTTPS (Docker derrière reverse proxy, etc.)
# SECURE_COOKIE=true

# --- Vercel (automatique sur Vercel) ---
# VERCEL=1
